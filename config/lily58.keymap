/*
 * Copyright (c) 2020 The ZMK Contributors
 *
 * SPDX-License-Identifier: MIT
 *
 * Kinesis Advantage2 (Mac mode) style base layer, so switching between the two
 * boards keeps the same muscle memory:
 *  - main grid matches the Kinesis key-for-key (= and - on the number row, \ on the right)
 *  - thumbs mirror the Kinesis clusters: Cmd/Opt | Bksp + Del, Space + Enter | Ctrl/Cmd
 *
 * Layers:
 *  - Nav (hold Enter): vim-style movement on the right hand, one-handed
 *  - Sym (hold Del):   programming symbols, bracket pairs mirrored on the home row
 *  - Sys (hold both):  F-keys, Bluetooth, output, bootloader, media
 */

#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/outputs.h>

#define BASE 0
#define NAV  1
#define SYM  2
#define SYS  3

// Hold Del or Enter for a layer. Tap-then-hold repeats the key.
&lt {
    tapping-term-ms = <200>;
    quick-tap-ms = <175>;
    flavor = "balanced";
};

/ {
    conditional_layers {
        compatible = "zmk,conditional-layers";
        nav_sym_to_sys {
            if-layers = <NAV SYM>;
            then-layer = <SYS>;
        };
    };

    macros {
        // JS arrow function
        m_arrow: m_arrow {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp EQUAL &kp GT>;
        };

        // PHP object operator
        m_obj: m_obj {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp MINUS &kp GT>;
        };

        // HTML closing tag
        m_close_tag: m_close_tag {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LT &kp FSLH>;
        };

        // JS template literal
        m_template: m_template {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp DOLLAR &kp LBRC>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
// ------------------------------------------------------------------------------------------------------------
// |   =   |  1  |  2  |  3   |  4   |  5   |                   |  6   |  7    |  8    |  9   |   0   |   -   |
// |  TAB  |  Q  |  W  |  E   |  R   |  T   |                   |  Y   |  U    |  I    |  O   |   P   |   \   |
// |  CAPS |  A  |  S  |  D   |  F   |  G   |                   |  H   |  J    |  K    |  L   |   ;   |   '   |
// | SHIFT |  Z  |  X  |  C   |  V   |  B   |  ESC   |  |   `   |  N   |  M    |  ,    |  .   |   /   | SHIFT |
//                     | CMD  | OPT  |DEL/SYM| BSPC  |  | SPACE |ENT/NAV| CTRL | CMD   |
            bindings = <
&kp EQUAL &kp N1 &kp N2 &kp N3   &kp N4   &kp N5                         &kp N6 &kp N7      &kp N8    &kp N9   &kp N0   &kp MINUS
&kp TAB   &kp Q  &kp W  &kp E    &kp R    &kp T                          &kp Y  &kp U       &kp I     &kp O    &kp P    &kp BSLH
&kp CAPS  &kp A  &kp S  &kp D    &kp F    &kp G                          &kp H  &kp J       &kp K     &kp L    &kp SEMI &kp SQT
&kp LSHFT &kp Z  &kp X  &kp C    &kp V    &kp B       &kp ESC  &kp GRAVE &kp N  &kp M       &kp COMMA &kp DOT  &kp FSLH &kp RSHFT
                        &kp LGUI &kp LALT &lt SYM DEL &kp BSPC &kp SPACE &lt NAV RET &kp RCTRL &kp RGUI
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        nav_layer {
// ------------------------------------------------------------------------------------------------------------
// |       |     |     |      |      |      |                   |      |       |       |      |       |       |
// |       | ESC |     |      |      |      |                   |  ⌘←  |  ⌥←   |  ⌥→   |  ⌘→  |       |       |
// |       | CTRL| OPT | CMD  | SHFT |      |                   |  <-  |   v   |   ^   |  ->  |       |       |
// |       | UNDO| CUT | COPY | PASTE| REDO |        |  |       | HOME | PGDN  | PGUP  | END  |       |       |
//                     |      |      |      |        |  |       |(held)|       |       |
            bindings = <
&trans &trans    &trans    &trans    &trans    &trans                         &trans       &trans       &trans        &trans       &trans &trans
&trans &kp ESC   &none     &none     &none     &none                          &kp LG(LEFT) &kp LA(LEFT) &kp LA(RIGHT) &kp LG(RIGHT) &none &none
&trans &kp LCTRL &kp LALT  &kp LGUI  &kp LSHFT &none                          &kp LEFT     &kp DOWN     &kp UP        &kp RIGHT    &none  &none
&trans &kp LG(Z) &kp LG(X) &kp LG(C) &kp LG(V) &kp LG(LS(Z)) &trans   &trans  &kp HOME     &kp PG_DN    &kp PG_UP     &kp END      &none  &trans
                           &trans    &trans    &trans        &trans   &trans  &trans       &trans       &trans
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        sym_layer {
// ------------------------------------------------------------------------------------------------------------
// |       |     |     |      |      |      |                   |      |       |       |      |       |       |
// |       |  !  |  @  |  #   |  $   |  %   |                   |  ^   |   &   |   *   |  ?   |   :   |       |
// |       |  `  |  <  |  (   |  {   |  [   |                   |  ]   |   }   |   )   |  >   |   ~   |       |
// |       |  \  |  |  |  -   |  =   |  +   |        |  |       |  _   |  =>   |  ->   |  </  |  ${   |       |
//                     |      |      |(held)|        |  |       |      |       |       |
            bindings = <
&trans &trans    &trans    &trans    &trans     &trans                        &trans     &trans     &trans    &trans      &trans       &trans
&trans &kp EXCL  &kp AT    &kp HASH  &kp DOLLAR &kp PRCNT                     &kp CARET  &kp AMPS   &kp ASTRK &kp QMARK   &kp COLON    &trans
&trans &kp GRAVE &kp LT    &kp LPAR  &kp LBRC   &kp LBKT                      &kp RBKT   &kp RBRC   &kp RPAR  &kp GT      &kp TILDE    &trans
&trans &kp BSLH  &kp PIPE  &kp MINUS &kp EQUAL  &kp PLUS  &trans    &trans    &kp UNDER  &m_arrow   &m_obj    &m_close_tag &m_template &trans
                           &trans    &trans     &trans    &trans    &trans    &trans     &trans     &trans
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        sys_layer {
// ------------------------------------------------------------------------------------------------------------
// |  F1   |  F2 |  F3 |  F4  |  F5  |  F6  |                   |  F7  |  F8   |  F9   |  F10 |  F11  |  F12  |
// | BTCLR | BT1 | BT2 |  BT3 |  BT4 |  BT5 |                   |      |       |       |      |       |       |
// | STUDIO| USB | BLE |      |      |      |                   | PREV | VOL-  | VOL+  | NEXT | PLAY  | MUTE  |
// | BOOT  |     |     |      |      |      |        |  |       |      |       |       |      |       | BOOT  |
//                     |      |      |(held)|        |  |       |(held)|       |       |
            bindings = <
&kp F1         &kp F2        &kp F3        &kp F4       &kp F5       &kp F6                           &kp F7     &kp F8       &kp F9       &kp F10    &kp F11  &kp F12
&bt BT_CLR     &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2 &bt BT_SEL 3 &bt BT_SEL 4                     &none      &none        &none        &none      &none    &none
&studio_unlock &out OUT_USB  &out OUT_BLE  &none        &none        &none                            &kp C_PREV &kp C_VOL_DN &kp C_VOL_UP &kp C_NEXT &kp C_PP &kp C_MUTE
&bootloader    &none         &none         &none        &none        &none     &none          &none   &none      &none        &none        &none      &none    &bootloader
                                           &none        &none        &trans    &none          &none   &trans     &none        &none
            >;
        };
    };
};
