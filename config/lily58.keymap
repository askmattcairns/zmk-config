 *
 * SPDX-License-Identifier: MIT
 *
 * Kinesis Advantage2 (Mac mode) style layout, so switching between the two
 * boards keeps the same muscle memory:
 *  - main grid matches the Kinesis key-for-key (= and - on the number row, \ on the right)
 *  - thumbs mirror the Kinesis clusters: Cmd/Opt | Bksp + Del, Space + Enter | Ctrl/Cmd
 *  - keys the Kinesis has but the Lily58 lacks (Esc + F-row, arrow row,
 *    Home/End/PgUp/PgDn) live on one layer, in the same finger positions
 */

#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/ext_power.h>

#define BASE 0
#define KIN  1

// Hold Del or Enter for the Kinesis-extras layer. Tap-then-hold repeats the key.
&lt {
    tapping-term-ms = <200>;
    quick-tap-ms = <175>;
    flavor = "balanced";
};

/ {
    keymap {
        compatible = "zmk,keymap";

        default_layer {
// ------------------------------------------------------------------------------------------------------------
// |   =   |  1  |  2  |  3   |  4   |  5   |                   |  6   |  7    |  8    |  9   |   0   |   -   |
// |  TAB  |  Q  |  W  |  E   |  R   |  T   |                   |  Y   |  U    |  I    |  O   |   P   |   \   |
// |  CAPS |  A  |  S  |  D   |  F   |  G   |                   |  H   |  J    |  K    |  L   |   ;   |   '   |
// | SHIFT |  Z  |  X  |  C   |  V   |  B   |  ESC   |  |   `   |  N   |  M    |  ,    |  .   |   /   | SHIFT |
//                     | CMD  | OPT  |DEL/L1| BSPC   |  | SPACE |ENT/L1| CTRL  | CMD   |
            bindings = <
&kp EQUAL &kp N1 &kp N2 &kp N3   &kp N4   &kp N5                         &kp N6 &kp N7      &kp N8    &kp N9   &kp N0   &kp MINUS
&kp TAB   &kp Q  &kp W  &kp E    &kp R    &kp T                          &kp Y  &kp U       &kp I     &kp O    &kp P    &kp BSLH
&kp CAPS  &kp A  &kp S  &kp D    &kp F    &kp G                          &kp H  &kp J       &kp K     &kp L    &kp SEMI &kp SQT
&kp LSHFT &kp Z  &kp X  &kp C    &kp V    &kp B       &kp ESC  &kp GRAVE &kp N  &kp M       &kp COMMA &kp DOT  &kp FSLH &kp RSHFT
                        &kp LGUI &kp LALT &lt KIN DEL &kp BSPC &kp SPACE &lt KIN RET &kp RCTRL &kp RGUI
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        kinesis_layer {
// ------------------------------------------------------------------------------------------------------------
// |  ESC  |  F1 |  F2 |  F3  |  F4  |  F5  |                   |  F6  |  F7   |  F8   |  F9  |  F10  |  F11  |
// | BTCLR | BT1 | BT2 |  BT3 |  BT4 |  BT5 |                   |      |       |       |      |       |  F12  |
// | STUDIO|     |     |      |      |      |                   |      |       |       |      |       |       |
// |       |  `  |     |  <-  |  ->  |      |        |  |       |      |   ^   |   v   |  [   |   ]   |       |
//                     | HOME | END  |      |        |  |       |      | PGUP  | PGDN  |
            bindings = <
&kp ESC        &kp F1       &kp F2       &kp F3       &kp F4       &kp F5                            &kp F6 &kp F7    &kp F8    &kp F9   &kp F10  &kp F11
&bt BT_CLR     &bt BT_SEL 0 &bt BT_SEL 1 &bt BT_SEL 2 &bt BT_SEL 3 &bt BT_SEL 4                      &trans &trans    &trans    &trans   &trans   &kp F12
&studio_unlock &trans       &trans       &trans       &trans       &trans                            &trans &trans    &trans    &trans   &trans   &trans
&trans         &kp GRAVE    &trans       &kp LEFT     &kp RIGHT    &trans       &trans     &trans    &trans &kp UP    &kp DOWN  &kp LBKT &kp RBKT &trans
                                         &kp HOME     &kp END      &trans       &trans     &trans    &trans &kp PG_UP &kp PG_DN
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };
    };
};
